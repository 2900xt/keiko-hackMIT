# Voloridge AWS instance — get these at the booth. Copy to voloridge.env (gitignored).
VOLO_HOST=ec2-xx-xx-xx-xx.compute-1.amazonaws.com   # public DNS or IP
VOLO_USER=ec2-user                                   # Amazon Linux 2023 default
VOLO_KEY=~/.ssh/voloridge-hackmit.pem                # chmod 600
VOLO_REMOTE_DIR=~/keiko                              # where the repo lands on the box
VOLO_REGION=us-east-1

# Optional. Only if Voloridge gives us a scratch bucket; otherwise rsync carries the feature tensors (~3.4 GB).
VOLO_S3_SCRATCH=
# Optional. A named profile if you have AWS creds locally; the instance itself uses its IAM role.
AWS_PROFILE=
