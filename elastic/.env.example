# Elastic Cloud (HackMIT sponsor credit: https://www.elastic.co/cloud/cloud-trial-overview/30-days)
# Either the deployment's Elasticsearch endpoint URL or its Cloud ID, plus an API key with write access.
ELASTIC_URL=https://my-deployment.es.us-east-1.aws.elastic.cloud:443
#ELASTIC_CLOUD_ID=keiko:dXMtZWFzdC0xLmF3cy5lbGFzdGljLmNsb3VkJGFiYzEyMyRkZWY0NTY=
ELASTIC_API_KEY=base64apikey==

# Kibana endpoint (data views, alert rule). Same API key works. Copy it from the Cloud console (deployment > Kibana >
# Copy endpoint): on legacy-format deployments (https://<uuid>.<region>.cloud.es.io) Kibana has a *different* uuid.
KIBANA_URL=https://my-deployment.kb.us-east-1.aws.elastic.cloud:443

# Optional: where the alert rule posts (Discord/Slack incoming webhook)
#KEIKO_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ask.py (the ES|QL agent) talks to Claude
ANTHROPIC_API_KEY=sk-ant-...
