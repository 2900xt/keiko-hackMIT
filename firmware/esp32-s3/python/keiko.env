# Keiko ESP32-S3 node settings. python/main.py reads this at startup; real environment
# variables and command-line flags take precedence. Re-read every second, so editing
# KEIKO_UDP_* here redirects the stream without a restart.

# Serial device the board is on: auto = the first Espressif (native USB) or CP210x (UART port) device
KEIKO_SERIAL_PORT=auto
# Only matters if the board is on its UART port; native USB CDC ignores the baud rate
KEIKO_SERIAL_BAUD=921600

# Where the UDP block stream goes:
#   auto / 127.0.0.1   the pipeline running on this laptop
#   192.168.x.y        a pipeline on another machine on the same network
KEIKO_UDP_HOST=auto
KEIKO_UDP_PORT=5005
# Node id in the packet header; the UNO Q node is 0
KEIKO_NODE_ID=1

# Also append everything to a WAV (~16 kB/s at 8 kHz):
#KEIKO_WAV=hydro.wav

# Silence the once-a-second health line:
#KEIKO_QUIET=1
