# Keiko UNO Q node settings. python/main.py reads this at startup; real environment
# variables take precedence. (App Lab's app.yaml cannot carry environment variables,
# so this file is how the app is configured when arduino-app-cli runs it.)

# Where the UDP block stream goes:
#   auto            the board's own Linux side -- the pipeline running on the UNO Q
#                   (resolves to the Docker gateway inside App Lab's container)
#   192.168.x.y     a laptop running the pipeline on the same network as the board
KEIKO_UDP_HOST=auto
KEIKO_UDP_PORT=5005
KEIKO_NODE_ID=0

# Also append everything to a WAV on the board (~6.7 kB/s; lands in the app folder):
#KEIKO_WAV=/app/python/hydro.wav

# Silence the once-a-second health line:
#KEIKO_QUIET=1
