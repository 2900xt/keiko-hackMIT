{
  "name": "keiko-site",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "sync-data": "rm -rf public/data && mkdir -p public && cp -R data public/data",
    "predev": "npm run sync-data",
    "dev": "next dev",
    "prebuild": "npm run sync-data",
    "build": "next build",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9"
  }
}
